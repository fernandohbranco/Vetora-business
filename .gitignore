# Sistema operacional
.DS_Store
Thumbs.db

# Editores
.vscode/
.idea/

# Claude Code (sessões locais, não devem ir pro repo)
.claude/projects/
.claude/sessions/
.claude/shell-snapshots/
.claude/telemetry/
.claude/file-history/
.claude/backups/

# Dependências
node_modules/

# Python
__pycache__/
*.pyc

# Arquivos temporários
*.log
*.tmp

# Drop zone do usuário (só o README vai versionado)
dados/*
!dados/README.md

# Clientes — cada um é repo VetoraOS próprio, versionado por si mesmo.
# O container não rastreia o trabalho dos clientes.
# Ancorado na raiz (/) para não casar com pastas "clientes" em outros lugares
# (ex: a skill .claude/skills/00-os/clientes/).
/clientes/
